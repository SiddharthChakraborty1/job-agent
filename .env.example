# Copy to .env and fill in your keys.
# OPENAI_API_KEY, COSTLY_MODEL, CHEAP_MODEL, and SERPER_API_KEY are required.

OPENAI_API_KEY=

# Deep-reasoning model: DorkingAgent + ValidationAgent
COSTLY_MODEL=gpt-4o

# Cost-efficient model: the three parallel Search Agents
CHEAP_MODEL=gpt-4o-mini

# Google Search via Serper (https://serper.dev)
SERPER_API_KEY=

# Google OAuth — same Client ID as VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=

# Random secret for signing session cookies (generate with: openssl rand -hex 32)
JWT_SECRET=

# Optional auth settings
JWT_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
